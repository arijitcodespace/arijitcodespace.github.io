source "https://rubygems.org"

# The site is built by GitHub Actions (.github/workflows/pages.yml), not by
# GitHub Pages' built-in builder, so plugins in _plugins/ and any gem below work.
gem "jekyll", "~> 4.3.4"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
  gem "jekyll-seo-tag"
  gem "jekyll-include-cache"
end
